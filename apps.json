[
  {
    "id": "my-apps-hub",
    "name": "내 앱 허브",
    "summary": "모든 앱을 한눈에 보고 Claude에게 수정을 맡기는 대시보드",
    "kind": "page",
    "status": "active",
    "repo": "CleanXYZ/my-apps-hub",
    "url": "https://cleanxyz.github.io/my-apps-hub/",
    "workOn": "web",
    "run": "npx serve .",
    "tags": [
      "허브"
    ]
  },
  {
    "id": "qa-shot",
    "name": "QA Shot",
    "summary": "Redmine에 올릴 캡처에 네모, 화살표, 번호, 요청 배지를 그리는 Windows 프로그램",
    "kind": "program",
    "status": "active",
    "repo": "CleanXYZ/qa-shot",
    "release": {
      "workflow": "release.yml"
    },
    "workOn": "desktop",
    "run": "npm run tauri dev",
    "tags": [
      "qa"
    ],
    "checks": [
      "캡처",
      "트레이",
      "단축키",
      "클립보드",
      "설치 파일 실행"
    ]
  },
  {
    "id": "commute-bus",
    "name": "출퇴근 버스",
    "summary": "3000번 출퇴근을 가장 빨리 하는 버스를 알려 주는 휴대폰 웹앱",
    "kind": "worker",
    "status": "active",
    "repo": "CleanXYZ/commute-bus",
    "url": "https://commute-bus.hunlab.workers.dev/",
    "deploy": {
      "target": "cf-worker",
      "project": "commute-bus"
    },
    "workOn": "web",
    "run": "npm run dev",
    "envNames": [
      "GBIS_KEY"
    ],
    "tags": [
      "생활"
    ]
  },
  {
    "id": "dictate",
    "name": "음성 받아쓰기",
    "summary": "말하면 글이 커서 자리에 들어가는 Windows 프로그램. Whisper를 내 컴퓨터에서 돌린다 (Rust 설치 파일 + Python 버전)",
    "kind": "program",
    "status": "active",
    "repo": "CleanXYZ/dictate",
    "release": {
      "workflow": "release.yml"
    },
    "workOn": "desktop",
    "run": "python\\run.bat",
    "tags": [
      "도구"
    ],
    "checks": [
      "마이크 입력",
      "받아쓰기 결과",
      "단축키",
      "트레이",
      "설치 파일 실행"
    ]
  },
  {
    "id": "mvpbest",
    "name": "MVP작 계산기",
    "summary": "MVP작을 나눠 할 때 캐시·마일리지 아이템 지출과 경매장 판매가를 기록해 순손익을 보는 계산기",
    "kind": "page",
    "status": "active",
    "repo": "CleanXYZ/mvpbest",
    "url": "https://mvpbest.pages.dev",
    "deploy": {
      "target": "cf-pages",
      "project": "mvpbest"
    },
    "workOn": "web",
    "run": "npx wrangler pages dev public",
    "tags": [
      "메이플"
    ]
  }
]
